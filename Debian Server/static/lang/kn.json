  "error_session_expired_title": "ಸೆಷನ್ ಅವಧಿ ಮುಗಿದಿದೆ",
  "help.admin": "ನಿರ್ವಾಹಕ ಕಾರ್ಯಗಳು",
  "help.admin_body": "<ul>\n    <li><strong>ಅಪಾಯ ವಲಯ</strong> &mdash; ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಮರುಹೊಂದಿಸಿ, ನಿರ್ವಾಹಕ ಪಾಸ್‌ವರ್ಡ್ ಬಲವಂತ ಮರುಹೊಂದಿಸಿ, ಲಾಗ್ ಧಾರಣೆಯನ್ನು ಹೊಂದಿಸಿ ಮತ್ತು ಆಡಿಟ್ ಲಾಗ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ.</li>\n    <li><strong>ಸೆಟ್ಟಿಂಗ್‌ಗಳು</strong> &mdash; ಡಾರ್ಕ್ ಮೋಡ್ ಟಾಗಲ್ ಮಾಡಿ, ಸಿಸ್ಟಮ್ ಮಾಹಿತಿ ವೀಕ್ಷಿಸಿ (Python ಆವೃತ್ತಿ, ಡೇಟಾಬೇಸ್ ಮಾರ್ಗ, ಹೋಸ್ಟ್‌ಹೆಸರು).</li>\n    <li><strong>ಸೆಟಪ್ ಸ್ಕ್ರಿಪ್ಟ್</strong> &mdash; ಹಾಟ್‌ಸ್ಪಾಟ್ ಅನ್ನು ಪ್ರೊವಿಷನ್ ಮಾಡಲು, ಅವಲಂಬನೆಗಳನ್ನು ಸ್ಥಾಪಿಸಲು ಮತ್ತು ಸಿಸ್ಟಮ್ಡ್ ಸೇವೆಯನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಲು <code>sudo ./setup_hub.sh</code> ರನ್ ಮಾಡಿ.</li>\n</ul>",
  "help.getting_started": "ಪ್ರಾರಂಭಿಸುವುದು",
  "help.getting_started_body": "<ul>\n    <li><strong>ಸಂಪರ್ಕಿಸಿ</strong> &mdash; ಹಬ್ ಲ್ಯಾಪ್‌ಟಾಪ್ ಪ್ರಸಾರ ಮಾಡುವ <strong>EduMesh</strong> Wi-Fi ಹಾಟ್‌ಸ್ಪಾಟ್‌ಗೆ ಸೇರಿ. ಕ್ಯಾಪ್ಟಿವ್ ಪೋರ್ಟಲ್ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ತೆರೆಯುತ್ತದೆ.</li>\n    <li><strong>ಅಪ್ಲಿಕೇಶನ್ ಸ್ಥಾಪಿಸಿ</strong> &mdash; ಸ್ವಾಗತ ಪುಟದಲ್ಲಿ, EduMesh APK ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ Android ಫೋನ್‌ನಲ್ಲಿ ಸ್ಥಾಪಿಸಿ. ಕೇಳಿದರೆ \"ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ಸ್ಥಾಪಿಸಿ\" ಸಕ್ರಿಯಗೊಳಿಸಿ.</li>\n    <li><strong>ನೋಂದಾಯಿಸಿ</strong> &mdash; ಅಪ್ಲಿಕೇಶನ್ ತೆರೆಯಿರಿ, ನಿಮ್ಮ ಹೆಸರನ್ನು ನಮೂದಿಸಿ, ಮತ್ತು ನೀವು ಸೇರಿದಿರಿ. ಹಬ್ ನಿಮಗೆ ಶಾಶ್ವತ ವಿದ್ಯಾರ್ಥಿ ಐಡಿ ನೀಡುತ್ತದೆ.</li>\n    <li><strong>ಕಲಿಯಲು ಪ್ರಾರಂಭಿಸಿ</strong> &mdash; ಪಠ್ಯಪುಸ್ತಕಗಳು, ವೀಡಿಯೊಗಳು ಮತ್ತು ಇತರ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ. ಆಫ್‌ಲೈನ್ ಬಳಸಲು ಅವುಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</li>\n</ul>",
  "help.page_title": "Lumina Hub | ಸಹಾಯ ಮತ್ತು ದಸ್ತಾವೇಜು",
  "help.subtitle": "ಲುಮಿನಾ ಹಬ್ ಮತ್ತು EduMesh ಅಪ್ಲಿಕೇಶನ್ ಬಳಸುವುದು ಹೇಗೆ.",
  "help.teachers": "ಶಿಕ್ಷಕರಿಗಾಗಿ",
  "help.teachers_body": "<ul>\n    <li><strong>ಸಂಪನ್ಮೂಲಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ</strong> &mdash; ವಿಷಯ ನಿರ್ವಾಹಕಕ್ಕೆ ಹೋಗಿ, PDF ಅಥವಾ ವೀಡಿಯೊ ಆಯ್ಕೆಮಾಡಿ, ಅದಕ್ಕೆ ಶೀರ್ಷಿಕೆ ಮತ್ತು ವಿಷಯ ನೀಡಿ, ಮತ್ತು ಅಪ್‌ಲೋಡ್ ಕ್ಲಿಕ್ ಮಾಡಿ. ಸಂಪನ್ಮೂಲಗಳು ತಕ್ಷಣ ಎಲ್ಲಾ ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ಲಭ್ಯವಾಗುತ್ತವೆ.</li>\n    <li><strong>ವಿಷಯ ನಿರ್ವಹಿಸಿ</strong> &mdash; ಸಂಪನ್ಮೂಲಗಳನ್ನು ಹುಡುಕಲು ವಿಷಯ ಮತ್ತು ತರಗತಿಯ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ. ಯಾವುದೇ ಸಂಪನ್ಮೂಲ ಮತ್ತು ಅದರ ಫೈಲ್ ಅನ್ನು ತೆಗೆದುಹಾಕಲು ಅಳಿಸು ಕ್ಲಿಕ್ ಮಾಡಿ.</li>\n    <li><strong>ವಿದ್ಯಾರ್ಥಿಗಳನ್ನು ವೀಕ್ಷಿಸಿ</strong> &mdash; ಎಲ್ಲಾ ನೋಂದಾಯಿತ ವಿದ್ಯಾರ್ಥಿಗಳನ್ನು ನೋಡಲಿ, ತರಗತಿಯ ಮೂಲಕ ಫಿಲ್ಟರ್ ಮಾಡಿ, ಅಥವಾ ಹೆಸರಿನಿಂದ ಹುಡುಕಿ. ಪ್ರತಿ ಕಾರ್ಡ್ ಸಾಪ್ತಾಹಿಕ ಅಧ್ಯಯನ ಸಮಯ, ಸ್ಟ್ರೀಕ್ ಮತ್ತು ಉಳಿಸಿದ ಸಂಪನ್ಮೂಲಗಳನ್ನು ತೋರಿಸುತ್ತದೆ.</li>\n    <li><strong>ವಿವರವಾದ ವಿಶ್ಲೇಷಣೆ</strong> &mdash; ಅಧ್ಯಯನ ಸಮಯ ವಿಭಜನೆ ಮತ್ತು ಸಂಪನ್ಮೂಲ ಎಣಿಕೆಯೊಂದಿಗೆ ಪೂರ್ಣ ಪ್ರೊಫೈಲ್ ನೋಡಲು ವಿದ್ಯಾರ್ಥಿಯ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ.</li>\n    <li><strong>ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಬದಲಾಯಿಸಿ</strong> &mdash; ನಿಮ್ಮ ಲಾಗಿನ್ ರುಜುವಾತುಗಳು, ಪ್ರದರ್ಶನ ಹೆಸರು ಮತ್ತು ಇಲಾಖೆಯನ್ನು ನವೀಕರಿಸಲು ಖಾತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ.</li>\n</ul>",
  "help.title": "ಸಹಾಯ ಮತ್ತು ಸೂಚನೆಗಳು",
  "help.tracking": "ವಿದ್ಯಾರ್ಥಿ ಟ್ರ್ಯಾಕಿಂಗ್",
  "help.tracking_body": "<ul>\n    <li><strong>ಅಧ್ಯಯನ ಸಮಯ</strong> &mdash; ಅಪ್ಲಿಕೇಶನ್ ಅಂತರ್ನಿರ್ಮಿತ ಟೈಮರ್ ಬಳಸಿ ಕೇಂದ್ರೀಕೃತ ಅಧ್ಯಯನ ಸೆಷನ್‌ಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ. ಒಟ್ಟು ಸಾಪ್ತಾಹಿಕ ನಿಮಿಷಗಳನ್ನು ಹಬ್‌ಗೆ ಸಿಂಕ್ ಮಾಡಲಾಗುತ್ತದೆ.</li>\n    <li><strong>ಸ್ಟ್ರೀಕ್</strong> &mdash; ವಿದ್ಯಾರ್ಥಿ ಅಪ್ಲಿಕೇಶನ್ ಬಳಸುವ ಸತತ ದಿನಗಳು. ಫೋನ್‌ನಲ್ಲಿ ಲೆಕ್ಕಹಾಕಿ ಹಬ್‌ಗೆ ಸಿಂಕ್ ಮಾಡಲಾಗುತ್ತದೆ.</li>\n    <li><strong>ಉಳಿಸಿದ ಸಂಪನ್ಮೂಲಗಳು</strong> &mdash; ವಿದ್ಯಾರ್ಥಿಯು ಸಂಪನ್ಮೂಲವನ್ನು ಬುಕ್‌ಮಾರ್ಕ್ ಮಾಡಿದಾಗ ಅಥವಾ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಎಣಿಕೆಯನ್ನು ನವೀಕರಿಸಲಾಗುತ್ತದೆ.</li>\n    <li><strong>ಗೌಪ್ಯತೆ</strong> &mdash; ವೈಯಕ್ತಿಕ ಘಟನೆಗಳು (ಯಾವ PDF ತೆರೆಯಲಾಗಿದೆ, ಏನು ಹುಡುಕಲಾಗಿದೆ) ವಿದ್ಯಾರ್ಥಿಯ ಫೋನ್‌ನಲ್ಲಿಯೇ ಉಳಿಯುತ್ತವೆ ಮತ್ತು ಹಬ್‌ಗೆ ಎಂದಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ.</li>\n</ul>",
  "help.troubleshooting": "ಸಮಸ್ಯೆ ಪರಿಹಾರ",
  "help.troubleshooting_body": "<ul>\n    <li><strong>ಅಪ್ಲಿಕೇಶನ್ ಸಂಪರ್ಕಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ</strong> &mdash; ನಿಮ್ಮ ಫೋನ್ EduMesh Wi-Fi ನಲ್ಲಿದೆ ಮತ್ತು ಹಬ್ ಲ್ಯಾಪ್‌ಟಾಪ್ ಆನ್ ಆಗಿದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ. ಅಪ್ಲಿಕೇಶನ್ ಮರುಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ಕೆಲವು ಸೆಕೆಂಡ್ ಕಾಯಿರಿ.</li>\n    <li><strong>ಪಾಸ್‌ವರ್ಡ್ ಮರೆತುಹೋಗಿದೆಯೇ</strong> &mdash; ಹಬ್ ಲ್ಯಾಪ್‌ಟಾಪ್‌ಗೆ ಕೀಬೋರ್ಡ್ ಸಂಪರ್ಕಿಸಿ ಮತ್ತು ಟರ್ಮಿನಲ್‌ನಲ್ಲಿ <code>sudo ./reset_admin.sh</code> ರನ್ ಮಾಡಿ. ಇದು ನಿರ್ವಾಹಕ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು <code>lumina2026</code> ಗೆ ಮರುಹೊಂದಿಸುತ್ತದೆ.</li>\n    <li><strong>ಅಪ್ಲಿಕೇಶನ್ ನಿಧಾನವಾಗಿದೆ</strong> &mdash; ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಚ್ಚಿ, EduMesh ಮರುಪ್ರಾರಂಭಿಸಿ, ಅಥವಾ Android ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಅಪ್ಲಿಕೇಶನ್ ಡೇಟಾವನ್ನು ಅಳಿಸಿ ಮರುಸ್ಥಾಪಿಸಿ.</li>\n    <li><strong>ಹಬ್ ಸಂಗ್ರಹಣೆ ತುಂಬಿದೆ</strong> &mdash; ವಿಷಯ ನಿರ್ವಾಹಕದಿಂದ ಬಳಕೆಯಾಗದ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಅಳಿಸಿ. <span data-i18n=\"sidebar.home\">ಮುಖಪುಟ</span> ಪುಟದಲ್ಲಿ ಡಿಸ್ಕ್ ಬಳಕೆ ಪರಿಶೀಲಿಸಿ. ಮುಂದುವರಿದ ಸ್ವಚ್ಛಗೊಳಿಸುವಿಕೆಗಾಗಿ, <code>sudo ./setup_hub.sh</code> ರನ್ ಮಾಡಿ.</li>\n</ul>",
