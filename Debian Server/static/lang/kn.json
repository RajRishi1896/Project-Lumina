  "welcome.download_offline": "ಆಫ್‌ಲೈನ್ ಗಾಗಿ ಡೌನ್‌ಲೋಡ್",
  "welcome.enter_both": "ದಯವಿಟ್ಟು ಬಳಕೆದಾರ ಹೆಸರು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಎರಡನ್ನೂ ನಮೂದಿಸಿ.",
  "welcome.for_teachers": "ಶಿಕ್ಷಕರಿಗಾಗಿ",
  "welcome.getting_started": "ಪ್ರಾರಂಭಿಸುವುದು",
  "welcome.guide.download_offline_body": "ಯಾವುದೇ ಸಂಪನ್ಮೂಲದ ಮೇಲೆ ಡೌನ್‌ಲೋಡ್ ಐಕಾನ್ ಟ್ಯಾಪ್ ಮಾಡಿ ಮತ್ತು ಅದು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತದೆ. ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಸಂಪನ್ಮೂಲಗಳು <strong>ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಸಂಪರ್ಕವಿಲ್ಲದೆಯೂ</strong> ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ. ಎಲ್ಲಿಯಾದರೂ ಓದಲು ಸೂಕ್ತ.",
  "welcome.guide.for_teachers_body": "ಶಿಕ್ಷಕರು ಮೇಲೆ ತಮ್ಮ ರುಜುವಾತುಗಳೊಂದಿಗೆ ಲಾಗಿನ್ ಮಾಡಬಹುದು. ಲಾಗಿನ್ ಮಾಡಿದ ನಂತರ, ನೀವು <strong>ಸಂಪನ್ಮೂಲಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಬಹುದು</strong>, <strong>ವಿದ್ಯಾರ್ಥಿ ವಿಶ್ಲೇಷಣೆಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು</strong>, <strong>ತರಗತಿಗಳು ಮತ್ತು ವಿಷಯಗಳನ್ನು ನಿರ್ವಹಿಸಬಹುದು</strong>, ಮತ್ತು <strong>ಹಬ್ ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಬಹುದು</strong> — ಪಾಸ್‌ವರ್ಡ್ ಬದಲಾಯಿಸುವುದು ಮತ್ತು ಸಂಗ್ರಹಣೆ ನಿರ್ವಹಣೆ ಸೇರಿದಂತೆ. ಲಾಗಿನ್ ಮಾಡಿದ ನಂತರ ಸೈಡ್‌ಬಾರ್‌ನಲ್ಲಿರುವ <strong>ಶಿಕ್ಷಕ ಮಾರ್ಗದರ್ಶಿ</strong> ಗೆ ಭೇಟಿ ನೀಡಿ.",
  "welcome.guide.getting_started_body": "<li><strong>Wi-Fi ಗೆ ಸಂಪರ್ಕಿಸಿ</strong> — ನಿಮ್ಮ ಫೋನ್ Wi-Fi ಆನ್ ಮಾಡಿ ಮತ್ತು <strong>EduMesh</strong> ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಸೇರಿ. ಪಾಸ್‌ವರ್ಡ್ ಅಗತ್ಯವಿಲ್ಲ.</li><li><strong>ಸ್ವಾಗತ ಪುಟ ತೆರೆಯಿರಿ</strong> — ಸಂಪರ್ಕವಾದ ನಂತರ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಲಾಗಿನ್ ಪರದೆ ಕಾಣಿಸಿಕೊಳ್ಳಬೇಕು. ಇಲ್ಲದಿದ್ದರೆ, ನಿಮ್ಮ ಬ್ರೌಸರ್ ತೆರೆದು <strong>http://lumina.hub:8000</strong> ಗೆ ಹೋಗಿ.</li><li><strong>ಅಪ್ಲಿಕೇಶನ್ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ</strong> — ಈ ಪುಟದ ಮೇಲಿನ ಬಲ ಮೂಲೆಯಲ್ಲಿರುವ <strong>ಅಪ್ಲಿಕೇಶನ್ ಡೌನ್‌ಲೋಡ್</strong> ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ.</li><li><strong>ಅಪ್ಲಿಕೇಶನ್ ಸ್ಥಾಪಿಸಿ</strong> — ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್ ತೆರೆದು ಇನ್‌ಸ್ಟಾಲ್ ಟ್ಯಾಪ್ ಮಾಡಿ. ಫೋನ್ ಕೇಳಿದರೆ, ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ “ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ಸ್ಥಾಪಿಸಿ” ಅನುಮತಿಸಿ.</li><li><strong>ನೋಂದಾಯಿಸಿ</strong> — EduMesh ಅಪ್ಲಿಕೇಶನ್ ತೆರೆದು, ನಿಮ್ಮ ಹೆಸರನ್ನು ನಮೂದಿಸಿ. ನಿಮಗೆ ಶಾಶ್ವತ ವಿದ್ಯಾರ್ಥಿ ಐಡಿ ನೀಡಲಾಗುತ್ತದೆ.</li><li><strong>ಕಲಿಯಲು ಪ್ರಾರಂಭಿಸಿ</strong> — ಪಠ್ಯಪುಸ್ತಕಗಳು, ವೀಡಿಯೊಗಳು, ಹಿಂದಿನ ಪ್ರಶ್ನೆಪತ್ರಿಕೆಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ. ಯಾವುದೇ ಸಂಪನ್ಮೂಲವನ್ನು ವೀಕ್ಷಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ ಅಥವಾ ಆಫ್‌ಲೈನ್ ಪ್ರವೇಶಕ್ಕಾಗಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</li>",
  "welcome.guide.tracking_privacy_body": "<p style=\"font-size:0.875rem;color:var(--text-secondary);line-height:1.7;\">ಅಪ್ಲಿಕೇಶನ್ ನಿಮ್ಮ <strong>ಅಧ್ಯಯನ ಸಮಯವನ್ನು</strong> ಅಂತರ್ನಿರ್ಮಿತ ಟೈಮರ್ ಮೂಲಕ ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ಸತತ ಅಧ್ಯಯನ ದಿನಗಳ <strong>ದೈನಂದಿನ ಸ್ಟ್ರೀಕ್</strong> ಅನ್ನು ಎಣಿಸುತ್ತದೆ. ಇದು ಶಿಕ್ಷಕರಿಗೆ ತರಗತಿಯು ಸಾಮಗ್ರಿಗಳೊಂದಿಗೆ ಹೇಗೆ ತೊಡಗಿಸಿಕೊಂಡಿದೆ ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತದೆ.</p><p style=\"font-size:0.875rem;color:var(--text-secondary);line-height:1.7;margin-top:0.5rem;\"><strong>ನಿಮ್ಮ ಗೌಪ್ಯತೆ ಮುಖ್ಯವಾಗಿದೆ.</strong> ವೈಯಕ್ತಿಕ ವಿವರಗಳು — ನೀವು ಯಾವ PDF ತೆರೆದಿದ್ದೀರಿ ಅಥವಾ ಏನನ್ನು ಹುಡುಕಿದ್ದೀರಿ — ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿಯೇ ಉಳಿಯುತ್ತವೆ ಮತ್ತು <strong>ಹಬ್‌ಗೆ ಎಂದಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ</strong>. ನಿಮ್ಮ ಒಟ್ಟು ಸಾಪ್ತಾಹಿಕ ನಿಮಿಷಗಳು, ಸ್ಟ್ರೀಕ್ ದಿನಗಳು ಮತ್ತು ಸಂಪನ್ಮೂಲಗಳ ಸಂಖ್ಯೆಯನ್ನು ಮಾತ್ರ ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ.</p>",
  "welcome.guide.troubleshooting_body": "<li><strong>Wi-Fi ಗೆ ಸಂಪರ್ಕಿಸಲು ಸಾಧ್ಯವಿಲ್ಲವೇ?</strong> ಹಬ್ ಲ್ಯಾಪ್‌ಟಾಪ್ ಆನ್ ಆಗಿದೆ ಮತ್ತು ಪ್ರಸಾರ ಮಾಡುತ್ತಿದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ. ನಿಮ್ಮ ಶಿಕ್ಷಕರನ್ನು ಪರಿಶೀಲಿಸಲು ಕೇಳಿ.</li><li><strong>ಕ್ಯಾಪ್ಟಿವ್ ಪೋರ್ಟಲ್ ತೆರೆಯುತ್ತಿಲ್ಲವೇ?</strong> ನಿಮ್ಮ ಬ್ರೌಸರ್ ತೆರೆದು <strong>http://lumina.hub:8000</strong> ಗೆ ಹೋಗಿ.</li><li><strong>ಅಪ್ಲಿಕೇಶನ್ ಸ್ಥಾಪಿಸಲಾಗುತ್ತಿಲ್ಲವೇ?</strong> ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಭದ್ರತೆಗೆ ಹೋಗಿ “ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ಸ್ಥಾಪಿಸಿ” ಸಕ್ರಿಯಗೊಳಿಸಿ. ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</li><li><strong>ಅಪ್ಲಿಕೇಶನ್ ನಿಧಾನ ಅಥವಾ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತಿದೆಯೇ?</strong> ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಚ್ಚಿ, EduMesh ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ, ಅಥವಾ Android ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಅಪ್ಲಿಕೇಶನ್ ಡೇಟಾವನ್ನು ಅಳಿಸಿ ಮರುಸ್ಥಾಪಿಸಿ.</li>",
  "welcome.guide.using_app_body": "<p style=\"font-size:0.875rem;color:var(--text-secondary);line-height:1.7;margin-bottom:0.75rem;\">EduMesh ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ಕೆಳಗೆ ನಾಲ್ಕು ಟ್ಯಾಬ್‌ಗಳಿವೆ:</p><ul style=\"font-size:0.875rem;color:var(--text-secondary);line-height:1.7;padding-left:1.25rem;\"><li><strong>ಡ್ಯಾಶ್‌ಬೋರ್ಡ್</strong> — ನಿಮ್ಮ ಅಧ್ಯಯನ ಅಂಕಿಅಂಶಗಳು, ಇತ್ತೀಚಿನ ಚಟುವಟಿಕೆ ಮತ್ತು ತ್ವರಿತ-ಪ್ರವೇಶ ಸಂಪನ್ಮೂಲಗಳನ್ನು ನೋಡಿ.</li><li><strong>ಬ್ರೌಸ್ ಮಾಡಿ</strong> — ಎಲ್ಲಾ ಲಭ್ಯವಿರುವ ಸಂಪನ್ಮೂಲಗಳನ್ನು ವಿಷಯ ಅಥವಾ ತರಗತಿಯ ಮೂಲಕ ಅನ್ವೇಷಿಸಿ. ಕೀವರ್ಡ್ ಮೂಲಕ ಹುಡುಕಿ.</li><li><strong>ಉಳಿಸಿದವು</strong> — ಆಫ್‌ಲೈನ್ ಬಳಕೆಗಾಗಿ ಬುಕ್‌ಮಾರ್ಕ್ ಅಥವಾ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಸಂಪನ್ಮೂಲಗಳನ್ನು ವೀಕ್ಷಿಸಿ.</li><li><strong>ಪ್ರೊಫೈಲ್</strong> — ನಿಮ್ಮ ಸಾಪ್ತಾಹಿಕ ಅಧ್ಯಯನ ಸಮಯ, ಸ್ಟ್ರೀಕ್ ಮತ್ತು ಉಳಿಸಿದ ಸಂಪನ್ಮೂಲಗಳ ಸಂಖ್ಯೆಯನ್ನು ನೋಡಿ.</li></ul>",
  "welcome.hero.subtitle": "ಸ್ಥಳೀಯ ಮೆಶ್‌ನಿಂದ ಪಠ್ಯಪುಸ್ತಕಗಳು, ವೀಡಿಯೊಗಳು ಮತ್ತು ಅಧ್ಯಯನ ಸಾಮಗ್ರಿಗಳನ್ನು ಪ್ರವೇಶಿಸಿ — ಇಂಟರ್ನೆಟ್ ಅಗತ್ಯವಿಲ್ಲ.",
