[Unit]
Description=Lumina Hub WiFi AP (hostapd + dnsmasq)
After=network-online.target
Before=lumina-hub.service
Wants=network-online.target

[Service]
Type=forking
ExecStartPre=/bin/sh -c '/usr/sbin/ip link set wlp0s20f3 down || true'
ExecStartPre=/bin/sh -c '/usr/sbin/ip addr flush dev wlp0s20f3 || true'
ExecStart=/bin/bash -c '/usr/sbin/ip addr add 10.42.0.1/24 dev wlp0s20f3 && /usr/sbin/ip link set wlp0s20f3 up && /usr/sbin/hostapd /etc/hostapd/hostapd.conf -B -P /run/hostapd.pid && /usr/sbin/dnsmasq --conf-file=/etc/dnsmasq-lumina.conf'
ExecStop=/bin/bash -c 'killall hostapd 2>/dev/null; killall dnsmasq 2>/dev/null; /usr/sbin/ip addr del 10.42.0.1/24 dev wlp0s20f3 2>/dev/null; /usr/sbin/ip link set wlp0s20f3 down 2>/dev/null'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
